{
  "name": "@sparkdynamic/email-builder",
  "version": "0.1.1",
  "description": "Email editor and renderer: block registry, canvas, inspector and email HTML output",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparkDynamic-GmbH/email-builder-js.git",
    "directory": "packages/email-builder"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./extensions": {
      "types": "./dist/exports/extensions.d.mts",
      "import": "./dist/exports/extensions.mjs"
    },
    "./blocks": {
      "types": "./dist/exports/blocks.d.mts",
      "import": "./dist/exports/blocks.mjs"
    },
    "./reader": {
      "types": "./dist/exports/reader.d.mts",
      "import": "./dist/exports/reader.mjs"
    },
    "./package.json": "./package.json",
    "./editor": {
      "types": "./dist/exports/editor.d.mts",
      "import": "./dist/exports/editor.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/editor/theme.css"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.tsx",
    "!src/**/__snapshots__",
    "NOTICE"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "tsup src/index.ts src/exports/extensions.ts src/exports/blocks.ts src/exports/reader.ts src/exports/editor.ts --outDir dist --clean --format esm --dts --sourcemap",
    "build:css": "tailwindcss --input src/editor/styles.css --output dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "zod": "^3"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "insane": "^2.6.2",
    "lucide-react": "^1.26.0",
    "radix-ui": "^1.6.7",
    "react-colorful": "^5.6.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/insane": "^1.0.0"
  }
}
