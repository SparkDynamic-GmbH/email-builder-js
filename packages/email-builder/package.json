{
  "name": "@sparkdynamic/email-builder",
  "version": "0.1.0",
  "description": "Email editor and renderer: block registry, canvas, inspector and email HTML output",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SparkDynamic-GmbH/email-builder-js.git",
    "directory": "packages/email-builder"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./extensions": {
      "types": "./dist/exports/extensions.d.mts",
      "import": "./dist/exports/extensions.mjs"
    },
    "./blocks": {
      "types": "./dist/exports/blocks.d.mts",
      "import": "./dist/exports/blocks.mjs"
    },
    "./reader": {
      "types": "./dist/exports/reader.d.mts",
      "import": "./dist/exports/reader.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/exports/extensions.ts src/exports/blocks.ts src/exports/reader.ts --outDir dist --format esm --dts --sourcemap"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "zod": "^3"
  },
  "dependencies": {
    "insane": "^2.6.2",
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "@types/insane": "^1.0.0"
  }
}
