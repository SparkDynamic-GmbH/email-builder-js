  "block-feature-05-title": {
    "type": "Text",
    "data": {
      "props": {
        "text": "<strong>Bauen Sie auf Vinosoft auf</strong>"
      },
      "style": {
        "padding": {
          "top": 0,
          "bottom": 0,
          "left": 0,
          "right": 0
        },
        "fontSize": 17,
        "fontWeight": "normal",
        "textAlign": "left",
        "color": "#2C2A28"
      }
    }
  },
  "block-feature-05-body": {
    "type": "Text",
    "data": {
      "props": {
        "text": "Entwickler können jetzt direkt über eine vollständige, dokumentierte REST-API integrieren – mit Zugriff auf Storefront, Administration und Kundenkonten, samt OpenAPI-/Swagger-Dokumentation, OAuth und sicheren Tokens."
      },
      "style": {
        "padding": {
          "top": 6,
          "bottom": 0,
          "left": 0,
          "right": 0
        },
        "fontSize": 15,
