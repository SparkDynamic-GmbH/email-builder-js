      }
    }
  },
  "block-feature-02-body": {
    "type": "Text",
    "data": {
      "props": {
        "text": "Zuoberst in der App gibt es jetzt eine einzige Suchleiste. Geben Sie einen Kundennamen, eine Rechnungsnummer, eine Offerte, eine Auftragsbestätigung, eine Bestellung oder einen Artikel ein – und springen Sie direkt dorthin. Die Ergebnisse zeigen Betrag und Status auf einen Blick, und jeder sieht nur, wozu er berechtigt ist."
      },
      "style": {
        "padding": {
          "top": 6,
          "bottom": 0,
          "left": 0,
          "right": 0
        },
        "fontSize": 15,
        "fontWeight": "normal",
        "textAlign": "left",
        "color": "#5C5651"
      }
    }
  },
  "block-feature-03": {
    "type": "ColumnsContainer",
    "data": {
      "style": {
