  "block-feature-02-title": {
    "type": "Text",
    "data": {
      "props": {
        "text": "<strong>Finden Sie alles – sofort</strong>"
      },
      "style": {
        "padding": {
          "top": 0,
          "bottom": 0,
          "left": 0,
          "right": 0
        },
        "fontSize": 17,
        "fontWeight": "normal",
